  "scenarios": [
    {
      "id": "cli_full_flow",
      "expected": "Two independently prepared and completed work items retain Current stamped evidence after ledger-only drift, while damaged selected report bytes invalidate verification until restored.",
      "required_observations": {
        "independent_sessions": true,
        "report_bytes_unchanged": true,
        "actual_checker_executed": true
      }
    },
    {
      "id": "cross_instance_transport",
      "expected": "Independent runtime instances can transport source and report bytes without copying SQLite state; old imported evidence stays historical until fresh local verification.",
      "required_observations": {
        "database_copied": false,
        "old_report_automatically_stamped": false,
        "fresh_checker_executed": true,
        "fresh_completion_event": "work.completed",
        "verified_completed": 2
      }
    },
    {
      "id": "stale_revision_retry",
      "expected": "A source edit between completion preflight and evidence registration is rejected without overwriting source bytes, and a retry of the old report remains historical.",
      "required_observations": {
        "rejected_write_had_no_evidence_side_effect": true,
        "source_bytes_preserved": true
      }
    },
    {
      "id": "git_revision_strict",
      "expected": "A matching task ledger section never makes evidence from an unrelated changed Git or code revision Current.",
      "required_observations": {
        "task_ledger_unchanged": true
      }
    }
  ],
  "poc": {
    "script": "tests/evidence-currency/poc.py",
    "report_name": "report.json",
    "required_fields": [
      "version",
      "passed",
      "scenarios",
      "steps",
      "inputs_unchanged",
      "input_hashes",
      "binary_sha256",
      "binary_unchanged",
      "binary_identity",
      "platform",
      "source_dirty",
      "verification_kind"
    ],
    "scenario_fields": [
      "id",
      "passed"
    ]
  },
  "cross_target_policy": "--target is compile-only evidence. It may report build success, but runtime tests and poc are not_run or unsupported and never count as a native pass. Foreign binaries are never executed.",
  "limitations": [
    "This contract verifies local Rust components, native CLI/MCP clients and the synthetic CLI POC; it does not invoke a model or establish E4 business acceptance.",
    "A dirty worktree is allowed and is recorded through source status and input hashes. A report is valid only for the exact recorded worktree and binaries.",
    "Cross-target compilation does not provide cross-platform test evidence; each native platform requires its own execution of the platform contract."
  ]
}
