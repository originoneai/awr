    ["member cell", ".block table.t tbody td:nth-child(1)", ".members-table tbody td:nth-child(1)", ["TEXT", "padding-top", "padding-bottom", "padding-left", "border-bottom-color", "vertical-align"]],
    ["who", ".block table.t tbody .who", ".members-table tbody .members-who", ["BOX", "__h"], {"skip": ["__w"]}],
