    ["group cell", ".block table.t tbody td:nth-child(2)", ".members-table tbody td:nth-child(2)", ["TEXT", "padding-top", "padding-bottom", "padding-left", "vertical-align"]],
    ["small text", ".block table.t tbody .sm", ".members-table tbody .members-small", ["TEXT"], {"skip": ["__w", "__h"]}],
    ["doing cell", ".block table.t tbody td:nth-child(4)", ".members-table tbody td:nth-child(4)", ["TEXT", "padding-top", "padding-bottom", "padding-left", "vertical-align"]],
    ["empty doing", ".block table.t tbody tr:first-child td:nth-child(4) .dim", ".members-table tbody tr:first-child td:nth-child(4) .members-dim", ["TEXT"], {"skip": ["__w", "__h"]}],
    ["chips", ".block table.t tbody .chips", ".members-table tbody .members-chips", ["BOX", "__h"], {"skip": ["__w"]}],
    ["chip", ".block table.t tbody .chip", ".members-table tbody .members-chip", ["BOX", "TEXT", "PAINT", "__h"], {"skip": ["__w"]}],
