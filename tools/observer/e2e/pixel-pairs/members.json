    ["pending heading", ".block table.t th:nth-child(6)", ".members-table thead th:nth-child(6)", ["TEXT", "padding-top", "padding-bottom", "padding-left", "__h"]],
    ["quiet pending cell", ".block table.t tbody tr:nth-child(3) td:nth-child(6)", ".members-table tbody tr:nth-child(3) td:nth-child(6)", ["TEXT", "padding-top", "padding-bottom", "padding-left", "vertical-align"]],
    ["navigation cell", ".block table.t tbody td.chevc", ".members-table tbody td.obs-table-arrow-column", ["BOX", "PAINT", "__w", "__h"]],
