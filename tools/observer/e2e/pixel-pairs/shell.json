{
 "page": "shell",
 "proto": "#p=activity&id=&tab=orders",
 "app": "/activity?project=P-001&kind=development",
 "ready": "[data-testid=\"page-activity\"]",
 "protoReady": ".block",
 "pairs": [
  ["page title (anchor)", ".head h1", ".obs-page-title", ["TEXT", "__ax", "__ay"], {"noPosition": true}],
  ["sidebar", "#side", ".shell-sider", ["background-color", "border-right-width", "border-right-color", "padding-left", "padding-right", "padding-top", "__ax", "__ay"], {"noPosition": true}],
  ["brand row", "#side .brand", ".shell-brand", ["__ax", "__ay", "margin-bottom"], {"noPosition": true}],
  ["brand wordmark", "#side .brand b", "[data-testid=\"brand-wordmark\"]", ["TEXT", "__ax", "__ay"], {"noPosition": true}],
  ["nav 1", "#side nav.nav:nth-of-type(1)", ".shell-sider nav:nth-of-type(1) ul.ant-menu", ["__ax", "__ay", "row-gap"], {"noPosition": true}],
  ["nav item 1", "#side nav.nav:nth-of-type(1) button:nth-child(1)", ".shell-sider nav:nth-of-type(1) li.ant-menu-item:nth-child(1)", ["__ax", "__ay", "padding-left", "padding-right", "border-top-left-radius", "background-color", "color"], {"noPosition": true}],
  ["nav item 1 icon", "#side nav.nav:nth-of-type(1) button:nth-child(1) svg", ".shell-sider nav:nth-of-type(1) li.ant-menu-item:nth-child(1) svg", ["__ax", "__ay", "color", "stroke-width"], {"noPosition": true}],
  ["nav item 1 label", "#side nav.nav:nth-of-type(1) button:nth-child(1) .name", ".shell-sider nav:nth-of-type(1) li.ant-menu-item:nth-child(1) .ant-menu-title-content a span", ["TEXT", "__ax", "__ay"], {"noPosition": true}],
  ["nav item 2 icon", "#side nav.nav:nth-of-type(1) button:nth-child(2) svg", ".shell-sider nav:nth-of-type(1) li.ant-menu-item:nth-child(2) svg", ["__ax", "__ay"], {"noPosition": true}],
  ["nav item 2 label", "#side nav.nav:nth-of-type(1) button:nth-child(2) .name", ".shell-sider nav:nth-of-type(1) li.ant-menu-item:nth-child(2) .ant-menu-title-content a span", ["TEXT", "__ax", "__ay"], {"noPosition": true}],
  ["side label", "#side .side-label", ".shell-side-label", ["TEXT", "padding-top", "padding-bottom", "padding-left", "__ax", "__ay"], {"noPosition": true}],
  ["nav 2", "#side nav.nav:nth-of-type(2)", ".shell-sider nav:nth-of-type(2) ul.ant-menu", ["__ax", "__ay"], {"noPosition": true}],
  ["nav 2 selected item", "#side nav.nav:nth-of-type(2) button:nth-child(2)", ".shell-sider nav:nth-of-type(2) li.ant-menu-item:nth-child(2)", ["__ax", "__ay", "background-color", "color", "border-top-left-radius", "font-weight"], {"noPosition": true}],
  ["nav 2 selected icon", "#side nav.nav:nth-of-type(2) button:nth-child(2) svg", ".shell-sider nav:nth-of-type(2) li.ant-menu-item:nth-child(2) svg", ["__ax", "__ay", "color"], {"noPosition": true}],
  ["nav 2 selected label", "#side nav.nav:nth-of-type(2) button:nth-child(2) .name", ".shell-sider nav:nth-of-type(2) li.ant-menu-item:nth-child(2) .ant-menu-title-content a span", ["TEXT", "__ax", "__ay"], {"noPosition": true}],
  ["theme button", "#side .side-foot button", ".shell-theme button", ["__ax", "__ay", "padding-left", "border-top-left-radius", "color"], {"noPosition": true}],
  ["theme icon", "#side .side-foot button svg", ".shell-theme button svg", ["__ax", "__ay"], {"noPosition": true}],
  ["theme label", "#side .side-foot button .lbl", ".shell-theme-label", ["TEXT", "__ax", "__ay"], {"noPosition": true}],
  ["topbar", ".top", ".shell-header", ["background-color", "border-bottom-width", "border-bottom-color", "padding-left", "padding-right", "__ax", "__ay"], {"noPosition": true}],
  ["crumb building icon", ".top .crumb > svg:first-child", ".shell-header nav.ant-breadcrumb svg:first-of-type", ["__ax", "__ay", "color"], {"noPosition": true}],
  ["crumb current page", ".top .crumb b", ".shell-header nav.ant-breadcrumb li:last-child .ant-breadcrumb-link span", ["TEXT", "__ax", "__ay"], {"noPosition": true}],
  ["crumb separator", ".top .crumb > svg:nth-of-type(2)", ".shell-header nav.ant-breadcrumb li.ant-breadcrumb-separator svg", ["__ax", "__ay", "__w", "__h", "color"], {"noPosition": true}],
  ["search button", ".top .search", ".shell-header > button:nth-of-type(1)", ["BOX", "background-color", "border-top-color", "box-shadow", "__ax", "__ay", "__w", "__h"], {"noPosition": true}],
  ["search icon", ".top .search svg", ".shell-header > button:nth-of-type(1) svg", ["__ax", "__ay", "color"], {"noPosition": true}],
  ["search label", ".top .search > span:nth-of-type(1)", ".shell-header > button:nth-of-type(1) > span:nth-of-type(2)", ["TEXT", "__ax", "__ay"], {"noPosition": true}],
  ["search shortcut", ".top .search .kbd", ".shell-header > button:nth-of-type(1) > span:nth-of-type(3)", ["TEXT", "background-color", "border-top-left-radius", "__ax", "__ay", "__w", "__h"], {"noPosition": true}],
  ["bell button", ".top .bell", ".shell-header .ant-badge button", ["__ax", "__ay", "__w", "__h", "border-top-left-radius", "color"], {"noPosition": true}],
  ["bell icon", ".top .bell svg", ".shell-header .ant-badge button svg", ["__ax", "__ay", "__w", "__h", "color"], {"noPosition": true}],
  ["avatar", ".top .av", "[data-testid=\"current-member-avatar\"]", ["__ax", "__ay", "__w", "__h", "background-color", "color", "border-top-left-radius"], {"noPosition": true}],
  ["avatar initial", ".top .av", "[data-testid=\"current-member-avatar\"]", ["TEXT"], {"noPosition": true}],
  ["content wrapper", ".wrap", ".shell-content", ["padding-top", "padding-left", "padding-right", "__ax", "__ay", "__w"], {"noPosition": true}],
  ["page header", ".head", ".obs-page-header", ["__ax", "__ay", "padding-top", "__h"], {"noPosition": true}]
 ]
}
