    ["docs block", ".cols2 > .stackv:last-child .block:nth-child(4)", "[data-testid=\"task-section-docs\"] .obs-section", ["BOX", "PAINT"]],
    ["lessons block", ".cols2 > .stackv:last-child .block:nth-child(5)", "[data-testid=\"task-section-lessons\"] .obs-section", ["BOX", "PAINT"], {"skip": ["__h"]}]
