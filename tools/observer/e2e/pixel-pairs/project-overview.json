{
  "page": "project-overview",
  "proto": "#p=project&id=orders&tab=overview",
  "app": "/projects/P-001?tab=overview",
  "ready": "[data-testid=\"project-instrument\"]",
  "protoReady": ".inst .kpis",
  "notes": {
    "geometryExclusions": [
      "Probe coordinates are anchored at the project page title (.hero h1 / [data-testid=\"project-title\"]), excluding shell-only header/sidebar offsets.",
      "Canonical demo server/demo-organization.js returns 2 open decisions (omitting data.project_questions) and 1 period update (canonicalPeriodUpdates slices to 1), and /api/team/activity returns structured operation verbs rather than prototype prose; container heights (__h) and downstream vertical positions (__y) that depend on item count or text length are skipped with no style skips.",
      "Tab 3 label uses '协作依赖' per AC 1 (prototype uses '依赖'), shifting later tab x coordinates (__x) slightly while keeping identical tab typography and spacing."
    ]
  },
  "pairs": [
    ["project title", ".hero h1", "[data-testid=\"project-title\"]", ["TEXT", "margin-top", "margin-bottom"]],
    ["back button", ".back", "[data-testid=\"project-back\"]", ["BOX", "TEXT", "margin-top"], {"skip": ["__y"]}],
    ["hero meta", ".hero .meta", "[data-testid=\"project-meta\"]", ["BOX", "TEXT", "margin-top"], {"skip": ["__w"]}],
    ["hero status tag", ".hero .meta .tag", "[data-testid=\"project-meta\"] .obs-tag", ["BOX", "TEXT", "background-color"]],
    ["hero lead avatar", ".hero .meta .av.s", "[data-testid=\"project-lead-link\"] .project-avatar", ["BOX", "TEXT", "background-color"], {"skip": ["__x"]}],
    ["tabs bar", ".tabs2", ".project-tabs .ant-tabs-nav", ["BOX", "border-bottom-color", "margin-bottom"], {"skip": ["__w"]}],
    ["active tab", ".tabs2 button[aria-selected=\"true\"]", ".project-tabs .ant-tabs-tab-active .ant-tabs-tab-btn", ["TEXT"], {"skip": ["__h", "__y"]}],
    ["instrument panel", ".inst", "[data-testid=\"project-instrument\"]", ["BOX", "PAINT"], {"skip": ["__h", "__w"]}],
    ["verdict top", ".inst-top", "[data-testid=\"project-verdict\"]", ["BOX", "background-color"], {"skip": ["__h", "__w"]}],
    ["verdict word pill", ".inst-top .word", "[data-testid=\"project-verdict-word\"]", ["BOX", "TEXT", "background-color"]],
    ["verdict word lamp", ".inst-top .word .lamp", "[data-testid=\"project-verdict-word\"] .obs-lamp", ["BOX", "background-color", "box-shadow"]],
    ["verdict sentence", ".inst-top .say", "[data-testid=\"project-verdict-sentence\"]", ["TEXT", "margin-top"], {"skip": ["__w", "__h"]}],
    ["verdict byline", ".inst-top .by", "[data-testid=\"project-verdict-byline\"]", ["TEXT", "margin-top"], {"skip": ["__w", "__y"]}],
    ["verdict basis button", ".inst-acts .btn", "[data-testid=\"project-verdict-basis-btn\"]", ["BOX", "PAINT", "TEXT"], {"skip": ["__x", "__w"]}],
    ["kpi strip", ".kpis", ".obs-kpis", ["BOX", "border-top-color", "border-bottom-color"], {"skip": ["__y", "__w", "__h"]}],
    ["kpi cell 1", ".kpis .kpi:nth-child(1)", ".obs-kpis .obs-kpi:nth-child(1)", ["BOX", "TEXT"], {"skip": ["__y", "__w", "__h"]}],
    ["kpi label 1", ".kpis .kpi:nth-child(1) .l", ".obs-kpis .obs-kpi:nth-child(1) .obs-kpi-label", ["TEXT"], {"skip": ["__y", "__w"]}],
    ["kpi value 1", ".kpis .kpi:nth-child(1) .v", ".obs-kpis .obs-kpi:nth-child(1) .obs-kpi-value", ["TEXT", "margin-top"], {"skip": ["__y", "__w"]}],
    ["kpi caption 1", ".kpis .kpi:nth-child(1) .c", ".obs-kpis .obs-kpi:nth-child(1) .obs-kpi-change", ["TEXT", "margin-top"], {"skip": ["__y", "__w"]}],
    ["kpi caption 2 warn", ".kpis .kpi:nth-child(2) .c", ".obs-kpis .obs-kpi:nth-child(2) .obs-kpi-change", ["TEXT"], {"skip": ["__x", "__y", "__w", "__h"]}],
    ["kpi caption 3 bad", ".kpis .kpi:nth-child(3) .c", ".obs-kpis .obs-kpi:nth-child(3) .obs-kpi-change", ["TEXT"], {"skip": ["__x", "__y", "__w", "__h"]}],
    ["workstreams block", ".inst-body .why", "[data-testid=\"project-workstreams\"]", ["BOX", "background-color"], {"skip": ["__y", "__w", "__h"]}],
    ["workstreams heading", ".why-head h2", "[data-testid=\"project-workstreams-title\"]", ["TEXT", "margin-top", "margin-bottom"], {"skip": ["__y"]}],
    ["workstreams legend", ".why-head .legend", "[data-testid=\"project-workstreams\"] .obs-legend", ["BOX", "TEXT"], {"skip": ["__x", "__y"]}],
    ["workstreams foot link", ".why-foot .link", "[data-testid=\"project-deps-link\"]", ["TEXT"], {"skip": ["__y"]}],
    ["waiting rail", ".inst-body .rail", "[data-testid=\"project-waiting-answers\"]", ["BOX", "background-color", "border-left-color"], {"skip": ["__x", "__y", "__h"]}],
    ["waiting rail heading", ".rail-head h2", "[data-testid=\"project-waiting-answers\"] .project-rail-head h2", ["TEXT", "margin-top", "margin-bottom"], {"skip": ["__x", "__y"]}],
    ["waiting rail count", ".rail-head .n", "[data-testid=\"project-waiting-answers-count\"]", ["BOX", "TEXT", "background-color"], {"skip": ["__x", "__y"]}],
    ["waiting rail card", ".rail .todo.min:nth-of-type(1)", "[data-testid=\"project-waiting-answer-item\"]:nth-of-type(1)", ["BOX", "PAINT", "TEXT"], {"skip": ["__x", "__y", "__w", "__h"]}],
    ["waiting rail card age", ".rail .todo.min:nth-of-type(1) .age", "[data-testid=\"project-waiting-answer-item\"]:nth-of-type(1) .project-answer-age", ["TEXT", "margin-top"], {"skip": ["__x", "__y", "__w"]}],
    ["lower two columns", ".cols2", ".project-overview-cols", ["margin-top"], {"skip": ["__y", "__w", "__h"]}],
    ["activity block", ".cols2 > .stackv:first-child .block", "[data-testid=\"project-activity\"] .obs-section", ["BOX", "PAINT"], {"skip": ["__y", "__w", "__h"]}],
    ["activity block head", ".cols2 > .stackv:first-child .block-head", "[data-testid=\"project-activity\"] .ant-card-head", ["BOX", "border-bottom-color"], {"skip": ["__y", "__w"]}],
    ["activity block title", ".cols2 > .stackv:first-child .block-head h2", "[data-testid=\"project-activity\"] .obs-section-title", ["TEXT"], {"skip": ["__y"]}],
    ["activity all link", ".cols2 > .stackv:first-child .block-head .link", "[data-testid=\"project-activity-all\"]", ["TEXT"], {"skip": ["__x", "__y"]}],
    ["updates block", ".cols2 > .stackv:last-child .block:nth-child(1)", "[data-testid=\"project-updates\"] .obs-section", ["BOX", "PAINT"], {"skip": ["__x", "__y", "__w", "__h"]}],
    ["updates block head", ".cols2 > .stackv:last-child .block:nth-child(1) .block-head", "[data-testid=\"project-updates\"] .ant-card-head", ["BOX", "border-bottom-color"], {"skip": ["__x", "__y", "__w"]}],
    ["updates block title", ".cols2 > .stackv:last-child .block:nth-child(1) .block-head h2", "[data-testid=\"project-updates\"] .obs-section-title", ["TEXT"], {"skip": ["__x", "__y"]}],
    ["reconciliation block", ".cols2 > .stackv:last-child .block:nth-child(2)", "[data-testid=\"project-reconciliation\"] .obs-section", ["BOX", "PAINT"], {"skip": ["__x", "__y", "__w", "__h"]}],
    ["reconciliation block head", ".cols2 > .stackv:last-child .block:nth-child(2) .block-head", "[data-testid=\"project-reconciliation\"] .ant-card-head", ["BOX", "border-bottom-color"], {"skip": ["__x", "__y", "__w"]}],
    ["reconciliation block title", ".cols2 > .stackv:last-child .block:nth-child(2) .block-head h2", "[data-testid=\"project-reconciliation\"] .obs-section-title", ["TEXT"], {"skip": ["__x", "__y"]}],
    ["reconciliation body", ".cols2 > .stackv:last-child .block:nth-child(2) .block-body", "[data-testid=\"project-reconciliation\"] .obs-section-content", ["BOX", "TEXT"], {"skip": ["__x", "__y", "__w", "__h"]}]
  ]
}
