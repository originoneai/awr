{
  "page": "workbench-dept",
  "proto": "#v=2&p=home&id=&tab=",
  "app": "/workbench?perspective=dept",
  "ready": "[data-testid=\"workbench-frame\"][data-perspective=\"dept\"]",
  "protoReady": ".inst",
  "notes": {
    "geometryExclusions": [
      "Probe coordinates are anchored at the page title (.head h1 vs .obs-page-title), so shell-only offsets cancel.",
      "The app renders an accepted freshness/coverage row (.obs-workbench-freshness) between the header and the instrument card, which shifts elements below the header downward (__y skipped on blocks below freshness).",
      "Table cell and panel heights/widths driven by text wrapping or platform font metrics (__w/__h) are skipped only on content-sized elements; zero style properties are skipped."
    ],
    "sharedCompletionTokens": "The page uses the shared CompletionBar and CompletionLegend components directly with craftThemes.*.chart.completion tokens (no nested color-mix). Legend swatch box geometry is paired without skipping any style property; the shared completion palette mismatch against prototype --v1..--v0 is reported in Questions for the supervisor."
  },
  "pairs": [
    ["page title", ".head h1", ".obs-page-title", ["TEXT", "margin-top", "margin-bottom"]],
    ["page subtitle", ".head .sub", ".obs-page-subtitle", ["TEXT", "margin-left"]],
    ["page header", ".head", ".obs-page-header", ["BOX"], {"skip": ["__w"]}],
    ["instrument card", ".inst", ".obs-workbench-instrument", ["BOX", "PAINT", "overflow-x"], {"skip": ["__y", "__w", "__h"]}],
    ["instrument top", ".inst-top", ".obs-workbench-verdict-top", ["BOX", "background-color"], {"skip": ["__y", "__w", "__h"]}],
    ["verdict", ".verdict", ".obs-workbench-verdict", ["flex-grow", "min-width"], {"skip": ["__y", "__w", "__h"]}],
    ["health word", ".verdict .word", ".obs-workbench-health-word", ["BOX", "TEXT", "background-color"], {"skip": ["__y"]}],
    ["health lamp", ".verdict .word .lamp", ".obs-workbench-health-word .obs-lamp", ["background-color", "box-shadow", "border-top-left-radius"], {"skip": ["__y"]}],
    ["say", ".verdict .say", ".obs-workbench-sentence", ["BOX", "TEXT"], {"skip": ["__y", "__w", "__h"]}],
    ["by", ".verdict .by", ".obs-workbench-byline", ["BOX", "TEXT"], {"skip": ["__y", "__w", "__h"]}],
    ["kpis", ".kpis", ".obs-kpis", ["BOX", "border-top-color", "border-bottom-color"], {"skip": ["__y", "__w", "__h"]}],
    ["kpi cell 1", ".kpis .kpi:nth-child(1)", ".obs-kpis .obs-kpi:nth-child(1)", ["BOX", "border-left-color"], {"skip": ["__y", "__w", "__h"]}],
    ["kpi cell 2", ".kpis .kpi:nth-child(2)", ".obs-kpis .obs-kpi:nth-child(2)", ["BOX", "border-left-color"], {"skip": ["__x", "__y", "__w", "__h"]}],
    ["kpi label", ".kpis .kpi:nth-child(1) .l", ".obs-kpis .obs-kpi:nth-child(1) .obs-kpi-label", ["TEXT"], {"skip": ["__y", "__w"]}],
    ["kpi value", ".kpis .kpi:nth-child(1) .v", ".obs-kpis .obs-kpi:nth-child(1) .obs-kpi-value", ["TEXT", "margin-top"], {"skip": ["__y", "__w"]}],
    ["kpi unit", ".kpis .kpi:nth-child(1) .v small", ".obs-kpis .obs-kpi:nth-child(1) .obs-kpi-value small", ["TEXT", "margin-left"], {"skip": ["__x", "__y", "__w"]}],
    ["kpi change warn", ".kpis .kpi:nth-child(1) .c", ".obs-kpis .obs-kpi:nth-child(1) .obs-kpi-change", ["TEXT", "margin-top"], {"skip": ["__y", "__w"]}],
    ["kpi change good", ".kpis .kpi:nth-child(2) .c", ".obs-kpis .obs-kpi:nth-child(2) .obs-kpi-change", ["TEXT", "margin-top"], {"skip": ["__x", "__y", "__w"]}],
    ["kpi emphasized value", ".kpis .kpi.me .v", ".obs-kpis .obs-kpi[data-emphasized=\"true\"] .obs-kpi-value", ["TEXT"], {"skip": ["__x", "__y", "__w"]}],
    ["inst body", ".inst-body", ".obs-workbench-body", ["display", "grid-template-columns"], {"skip": ["__y", "__w", "__h"]}],
    ["why (chain block)", ".why", ".obs-chain-block", ["BOX", "PAINT"], {"skip": ["__y", "__w", "__h"]}],
    ["why head", ".why-head", ".obs-workbench-chain-head", ["BOX"], {"skip": ["__y", "__w", "__h"]}],
    ["why head h2", ".why-head h2", ".obs-workbench-chain-head h2", ["TEXT", "margin-top", "margin-bottom"], {"skip": ["__y"]}],
    ["why head tag", ".why-head .tag", ".obs-workbench-chain-head > .obs-tag", ["BOX", "TEXT", "background-color", "box-shadow"], {"skip": ["__x", "__y", "__w"]}],
    ["why head seg", ".why-head .seg", ".obs-workbench-chain-switch", ["BOX", "background-color", "border-top-left-radius"], {"skip": ["__x", "__y", "__w"]}],
    ["why head seg selected", ".why-head .seg button[aria-pressed=\"true\"]", ".obs-workbench-chain-switch button[aria-pressed=\"true\"]", ["height", "background-color", "color", "box-shadow", "font-weight"], {"skip": ["__x", "__y", "__w"]}],
    ["why head seg button", ".why-head .seg button:not([aria-pressed=\"true\"])", ".obs-workbench-chain-switch button[aria-pressed=\"false\"]", ["height", "padding-left", "padding-right", "TEXT"], {"skip": ["__x", "__y", "__w"]}],
    ["chain row", ".why .chain", ".obs-workbench-body .obs-chain", ["display", "align-items", "margin-top", "flex-direction"], {"skip": ["__y", "__w", "__h"]}],
    ["chain root", ".why .cn.root", ".obs-workbench-body .obs-chain-node-root", ["BOX", "PAINT"], {"skip": ["__y", "__w", "__h"]}],
    ["chain root kicker", ".why .cn.root .k", ".obs-workbench-body .obs-chain-node-root .obs-chain-kicker", ["TEXT"], {"skip": ["__y", "__w"]}],
    ["chain root title", ".why .cn.root .t", ".obs-workbench-body .obs-chain-node-root .obs-chain-title", ["TEXT"], {"skip": ["__y", "__w"]}],
    ["chain queue", ".why .cn.root .ql", ".obs-workbench-body .obs-chain-node-root .obs-chain-queue", ["BOX", "background-color", "box-shadow"], {"skip": ["__y", "__w", "__h"]}],
    ["why foot", ".why-foot", ".obs-chain-footer", ["BOX", "TEXT"], {"skip": ["__y", "__w", "__h"]}],
    ["why foot cta", ".why-foot .link", ".obs-chain-footer .obs-workbench-chain-cta", ["TEXT"], {"skip": ["__x", "__y", "__w"]}],
    ["rail", ".rail", ".obs-todo-rail", ["BOX", "border-left-color", "background-color"], {"skip": ["__x", "__y", "__h"]}],
    ["rail head", ".rail-head", ".obs-todo-head", ["BOX"], {"skip": ["__x", "__y", "__w"]}],
    ["rail title", ".rail-head h2", ".obs-todo-head h2", ["TEXT", "margin-top"], {"skip": ["__x", "__y"]}],
    ["rail count", ".rail-head .n", ".obs-todo-count", ["BOX", "TEXT", "background-color", "border-top-left-radius"], {"skip": ["__x", "__y"]}],
    ["rail first card", ".todo.first", ".obs-todo-card", ["BOX", "PAINT", "text-align"], {"skip": ["__x", "__y", "__w", "__h"]}],
    ["rail first title", ".todo.first .tt", ".obs-todo-card .obs-todo-title", ["TEXT", "margin-top"], {"skip": ["__x", "__y", "__w", "__h"]}],
    ["rail first detail", ".todo.first .dd", ".obs-todo-card .obs-todo-detail", ["TEXT", "margin-top"], {"skip": ["__x", "__y", "__w", "__h"]}],
    ["panel", ".panel", ".obs-detail-panel", ["BOX", "PAINT"], {"skip": ["__y", "__w", "__h"]}],
    ["panel tabs", ".ptabs", ".obs-detail-tabs .ant-tabs-nav", ["BOX", "border-bottom-color"], {"skip": ["__y", "__w"]}],
    ["panel tab selected", ".ptabs .tab[aria-selected=\"true\"]", ".obs-detail-tabs .ant-tabs-tab-active .ant-tabs-tab-btn", ["TEXT"], {"skip": ["__y", "__w"]}],
    ["panel tab count", ".ptabs .tab .n", ".obs-detail-tab-count", ["TEXT", "margin-left"], {"skip": ["__x", "__y", "__w"]}],
    ["legend", ".ptabs .legend", ".obs-detail-tabs .obs-legend", ["BOX", "TEXT"], {"skip": ["__x", "__y", "__w"]}],
    ["legend swatch", ".ptabs .legend i", ".obs-detail-tabs .obs-legend-swatch", ["BOX"], {"skip": ["__x", "__y"]}],
    ["table", ".panel table.t", ".obs-detail-panel .obs-data-table table", ["width", "table-layout", "border-collapse"], {"skip": ["__y", "__w", "__h"]}],
    ["table head cell", ".panel table.t th", ".obs-detail-panel .obs-data-table thead th", ["TEXT", "padding-top", "padding-bottom", "padding-left", "border-bottom-color"], {"skip": ["__y", "__w"]}],
    ["project name", ".panel table.t tbody tr:first-child td:first-child > div:first-child", ".obs-detail-panel .obs-data-table tbody tr:first-child .obs-workbench-unit-name", ["TEXT"], {"skip": ["__y", "__w"]}],
    ["project meta", ".panel table.t tbody tr:first-child td:first-child .sm", ".obs-detail-panel .obs-data-table tbody tr:first-child .obs-workbench-unit-meta", ["TEXT"], {"skip": ["__y", "__w"]}],
    ["status tag", ".panel table.t tbody tr:first-child .tag", ".obs-detail-panel .obs-data-table tbody tr:first-child .obs-tag", ["BOX", "TEXT", "background-color"], {"skip": ["__x", "__y"]}],
    ["completion summary", ".panel table.t tbody tr:first-child .seg4 + .sm", ".obs-detail-panel .obs-data-table tbody tr:first-child .obs-completion-summary", ["TEXT", "margin-top"], {"skip": ["__x", "__y", "__w"]}],
    ["update time late", ".panel table.t tbody tr:nth-child(3) td:nth-child(5) .num", ".obs-detail-panel .obs-data-table tbody tr:nth-child(3) .obs-workbench-unit-time", ["TEXT"], {"skip": ["__x", "__y", "__w"]}],
    ["update late note", ".panel table.t tbody tr:nth-child(3) td:nth-child(5) .sm", ".obs-detail-panel .obs-data-table tbody tr:nth-child(3) .obs-workbench-unit-late", ["TEXT"], {"skip": ["__x", "__y", "__w"]}],
    ["panel footer note", ".panel .pnote", ".obs-detail-footer", ["BOX", "TEXT", "border-top-color"], {"skip": ["__y", "__w", "__h"]}]
  ]
}
