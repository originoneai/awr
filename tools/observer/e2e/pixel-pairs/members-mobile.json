{
  "page": "members-mobile",
  "proto": "#p=members",
  "app": "/members?scope=P-001",
  "ready": "[data-testid=\"member-table\"]",
  "protoReady": ".block table.t",
  "colorAssertion": "The same 8-bit colour assertions as members.json; optional columns removed from the small viewport are not paired",
  "pairs": [
    ["page title", ".head h1", ".obs-page-title", ["TEXT", "margin-top", "margin-bottom"]],
    ["page subtitle", ".head .sub", ".obs-page-subtitle", ["TEXT", "margin-left"], {"skip": ["color"]}],
    ["page header", ".head", ".obs-page-header", ["BOX", "__h"]],
    ["lead", ".lead", ".members-lead", ["BOX", "TEXT", "__h"]],
    ["member block", ".block", ".members-section", ["BOX", "PAINT", "__w"], {"skip": ["__h"]}],
    ["block head", ".block-head", ".members-section .ant-card-head", ["BOX", "border-bottom-color"]],
    ["block title", ".block-head h2", ".members-section .obs-section-title", ["TEXT", "margin-top", "margin-bottom"]],
    ["block count", ".block-head .n", ".members-section .obs-section-count", ["BOX", "TEXT", "background-color"], {"skip": ["__w", "__h", "color"]}],
    ["table", ".block table.t", ".members-table .ant-table-content table", ["width", "table-layout", "border-collapse", "__w"], {"skip": ["__h"]}],
    ["table head cell", ".block table.t th", ".members-table thead th", ["TEXT", "padding-top", "padding-bottom", "padding-left", "border-bottom-color", "__h"], {"skip": ["color"]}],
    ["member cell", ".block table.t tbody td:nth-child(1)", ".members-table tbody td:nth-child(1)", ["TEXT", "padding-top", "padding-bottom", "padding-left", "border-bottom-color", "vertical-align"]],
    ["who", ".block table.t tbody .who", ".members-table tbody .members-who", ["BOX", "__h"], {"skip": ["__w"]}],
    ["avatar", ".block table.t tbody .av", ".members-table tbody .members-avatar", ["BOX", "TEXT", "PAINT", "__w", "__h"]],
    ["member name", ".block table.t tbody .who .n", ".members-table tbody .members-name", ["TEXT"], {"skip": ["__w", "__h"]}],
    ["group cell", ".block table.t tbody td:nth-child(2)", ".members-table tbody td:nth-child(2)", ["TEXT", "padding-top", "padding-bottom", "padding-left", "vertical-align"]],
    ["small text", ".block table.t tbody .sm", ".members-table tbody .members-small", ["TEXT"], {"skip": ["__w", "__h", "color"]}],
    ["doing cell", ".block table.t tbody td:nth-child(4)", ".members-table tbody td:nth-child(3)", ["TEXT", "padding-top", "padding-bottom", "padding-left", "vertical-align"], {"skip": ["color"]}],
    ["empty doing", ".block table.t tbody tr:first-child td:nth-child(4) .dim", ".members-table tbody tr:first-child td:nth-child(3) .members-dim", ["TEXT"], {"skip": ["__w", "__h", "color"]}],
    ["pending heading", ".block table.t th:nth-child(6)", ".members-table thead th:nth-child(4)", ["TEXT", "padding-top", "padding-bottom", "padding-left", "__h"], {"skip": ["color"]}],
    ["quiet pending cell", ".block table.t tbody tr:nth-child(3) td:nth-child(6)", ".members-table tbody tr:nth-child(3) td:nth-child(4)", ["TEXT", "padding-top", "padding-bottom", "padding-left", "vertical-align"], {"skip": ["color"]}],
    ["navigation cell", ".block table.t tbody td.chevc", ".members-table tbody td.obs-table-arrow-column", ["BOX", "PAINT", "__w", "__h"], {"skip": ["border-top-color", "border-left-color"]}],
    ["navigation icon", ".block table.t tbody td.chevc svg", ".members-table tbody td.obs-table-arrow-column svg", ["__w", "__h", "stroke-width"]],
    ["note", ".pnote", ".members-pnote", ["BOX", "TEXT", "border-top-color", "__h"], {"skip": ["color"]}]
  ]
}
