# Merge this table into the target project's .codex/config.toml after replacing
# both absolute paths. Keep any existing configuration and hooks.
# Project configuration is loaded only for a trusted project.
#
# Published AWR 0.5.1 and this source tree advertise grouped domain tools.
# A domain entry permits every child inside that domain. Add awr_session,
# awr_continuity, awr_change or awr_compaction only when the task needs them.
[mcp_servers.awr]
command = "/absolute/path/to/awr-mcp"
args = ["--project", "/absolute/path/to/initialized/project"]
cwd = "/absolute/path/to/initialized/project"
enabled_tools = [
  "awr_query",
  "awr_context",
  "awr_work",
  "awr_evidence",
]

# Flat child names such as awr_project_status are not top-level names in grouped
# mode. For that exact legacy allowlist, use config.flat.toml.example.
#
# This file is a template, not an installed server or a lifecycle hook.
# Inspect /mcp in the receiving client to confirm a live connection.
